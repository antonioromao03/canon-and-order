# Copy to .env and fill in. Nothing here is needed until week 3.
TMDB_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# live | record | replay. CI always uses replay (no keys, no network).
CACHE_MODE=replay

# Wikimedia asks every client to identify itself with a contact URL or email.
HTTP_USER_AGENT="canon-and-order/0.1 (https://github.com/antonioromao03/canon-and-order)"
